# ─── Postgres (source of truth for site data) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/irforge

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# ─── Auth / secrets ─────────────────────────────────────────────────────────
BOT_TOKEN_ENCRYPTION_KEY=
SUPER_ADMIN_CODE=

# Shared secret for POST /api/internal/bots/:botId/purge — checked against the
# X-Internal-Secret header instead of a normal user session. Called by
# mainbot's scheduled expiry job (see docs/DELETION_POLICY.md). Must be set to
# the EXACT SAME value as INTERNAL_PURGE_SECRET in the mainbot service on
# Railway, or every purge call from mainbot gets a 403.
INTERNAL_PURGE_SECRET=

# ─── Telegram / support-bot integration ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SUPPORT_BOT_WEBHOOK_URL=
SUPPORT_BOT_WEBHOOK_SECRET=
SUPPORT_TICKET_API_KEY=

# ─── Google Sheets ──────────────────────────────────────────────────────────
# This project unifies its Google Sheets env var names with the mainbot and
# support-bot repos (see docs/DATA_UNIFICATION.md). Both the credential and
# the registry spreadsheet id now have a *unified* name that's read first,
# with the legacy web-only name kept as an automatic fallback — so nothing
# breaks if Railway still has only the old name set.

# Credential — set ONE of the following two options:
#
#   Option A (preferred, unified — same var name mainbot/support-bot use):
#   the full service-account JSON key file contents, as a single-line string.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
#   Option B (legacy fallback — only read if GOOGLE_CREDENTIALS_JSON is unset):
#   the email and private key as two separate vars (PEM, \n as literal \n).
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Registry spreadsheet id (the shared `tenants` sheet all three services read/
# write) — set ONE of the following two:
#
#   Preferred, unified — same var name mainbot/support-bot use:
REGISTRY_SPREADSHEET_ID=
#
#   Legacy fallback (only read if REGISTRY_SPREADSHEET_ID is unset):
# SHEETS_REGISTRY_ID=

# Business-data mirror spreadsheet — separate from the registry above, web-only,
# fire-and-forget mirror of Postgres (not part of the name-unification effort).
SHEETS_DATA_ID=
