# ─── Postgres (source of truth for site data) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/irforge

# ─── Postgres مربوط به خودِ بات (هر دو اختیاری، هر دو جدا از DATABASE_URL بالا) ──
#
# BOT_CACHE_DATABASE_URL — همان Postgresی که mainbot با DATABASE_URL/POSTGRES_URL
# خودش باز می‌کند (bot/utils/postgres_store.py). بات هر تب شیت را تا ۶۰ ثانیه
# در جدول `irforge_cache` کش می‌کند با کلید `<spreadsheetId>:<tabName>`. وقتی
# سایت روی شیت تننت می‌نویسد، این ردیف پاک می‌شود تا بات تغییر را تقریباً فوری
# ببیند به‌جای اینکه تا ۶۰ ثانیه دیتای کهنه سرو کند (api-server/src/lib/botCacheBust.ts).
# اگر ست نباشد همه‌چیز کار می‌کند، فقط تغییرات سایت تا یک دقیقه روی بات دیر
# اعمال می‌شوند. عمداً به DATABASE_URL بالا fallback نمی‌کند — این دو معمولاً
# دو دیتابیس متفاوت‌اند و نوشتن روی اشتباهی بدتر از ننوشتن است.
# BOT_CACHE_DATABASE_URL=postgresql://user:password@bot-host:5432/mainbot
#
# BUSINESS_DATABASE_URL — همان دیتابیسی که mainbot برای PHASE 17 استفاده می‌کند
# (bot/utils/db_business.py). فقط جدول `entity_cutover_flags` از آن خوانده
# می‌شود: اگر برای یک entity (مثلاً `panels`) پرچم use_db=true باشد، بات آن را
# از Postgres می‌خواند نه از شیت، و نوشتن سایت روی شیت بی‌اثر می‌شود — در آن
# حالت API با ۴۰۹ `entity_on_postgres` جواب می‌دهد به‌جای اینکه وانمود کند ذخیره شد.
# اگر ست نباشد، fail-open است (دقیقاً مثل خود بات): همه‌چیز روی شیت فرض می‌شود.
# BUSINESS_DATABASE_URL=postgresql://user:password@bot-host:5432/mainbot_business

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# REQUIRED IN PRODUCTION — the server refuses to boot without it (see
# lib/corsConfig.ts). Unset, CORS falls back to reflecting whatever Origin
# the request sent, which — combined with credentials: true — lets any
# website make authenticated requests against this API on a visitor's
# behalf. A single origin, or a comma-separated list for multiple
# frontends (e.g. a staging domain sharing this API).
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# ─── Auth / secrets ─────────────────────────────────────────────────────────
BOT_TOKEN_ENCRYPTION_KEY=
SUPER_ADMIN_CODE=

# HMAC key for hashing one-time codes before they're stored (lib/otp.ts).
# REQUIRED IN PRODUCTION, at least 32 random characters — the server refuses
# to boot without it. Rotating it invalidates in-flight codes only (5-minute
# TTL), which is fine; generate with e.g. `openssl rand -hex 32`.
OTP_SECRET=

# Shared secret for POST /api/internal/bots/:botId/purge — checked against the
# X-Internal-Secret header instead of a normal user session. Called by
# mainbot's scheduled expiry job (see docs/DELETION_POLICY.md). Must be set to
# the EXACT SAME value as INTERNAL_PURGE_SECRET in the mainbot service on
# Railway, or every purge call from mainbot gets a 403.
INTERNAL_PURGE_SECRET=

# Shared secret for POST /api/internal/tickets/notify-new — checked against
# the X-Ticket-Notify-Secret header. Called by mainbot whenever a user opens
# (or an SLA sweep escalates) a ticket in a tenant bot, so the bot's owner
# gets notified on the website/platform bot side too (IRFORGE_PROMPT_V3
# Phase 16). A DIFFERENT value from INTERNAL_PURGE_SECRET on purpose — must
# match TICKET_NOTIFY_SECRET in the mainbot service on Railway.
TICKET_NOTIFY_SECRET=

# ─── Telegram / support-bot integration ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SUPPORT_BOT_WEBHOOK_URL=
SUPPORT_BOT_WEBHOOK_SECRET=
SUPPORT_TICKET_API_KEY=

# ─── Delivery layer: SMS + email (Phase 12) ────────────────────────────────
# Both optional. Telegram remains the primary channel for every OTP this
# site sends (registration, login, password reset) — these add a second,
# parallel channel (Phase 13) and a real email-based signup path (Phase 14).
# Leaving either unset just disables that channel; nothing else breaks.
#
# Email — plain SMTP, works with Gmail/SES/SendGrid/Mailgun/Postmark/a
# self-hosted server, whatever's already on hand:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
#
# SMS — a generic HTTP gateway, since there's no SMTP-equivalent universal
# protocol: SMS_GATEWAY_BODY_TEMPLATE describes your provider's request body
# once as JSON, with {to}/{text}/{apiKey} filled in per send. The default
# below is a reasonable starting shape; most providers just need the field
# names changed to match (e.g. Kavenegar-style gateways use
# {"receptor":"{to}","message":"{text}"}).
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=POST
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BODY_TEMPLATE={"to":"{to}","text":"{text}","apiKey":"{apiKey}"}

# ─── Google Sheets ──────────────────────────────────────────────────────────
# This project unifies its Google Sheets env var names with the mainbot and
# support-bot repos (see docs/DATA_UNIFICATION.md). Both the credential and
# the registry spreadsheet id now have a *unified* name that's read first,
# with the legacy web-only name kept as an automatic fallback — so nothing
# breaks if Railway still has only the old name set.

# Credential — set ONE of the following two options:
#
#   Option A (preferred, unified — same var name mainbot/support-bot use):
#   the full service-account JSON key file contents, as a single-line string.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
#   Option B (legacy fallback — only read if GOOGLE_CREDENTIALS_JSON is unset):
#   the email and private key as two separate vars (PEM, \n as literal \n).
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Registry spreadsheet id (the shared `tenants` sheet all three services read/
# write) — set ONE of the following two:
#
#   Preferred, unified — same var name mainbot/support-bot use:
REGISTRY_SPREADSHEET_ID=
#
#   Legacy fallback (only read if REGISTRY_SPREADSHEET_ID is unset):
# SHEETS_REGISTRY_ID=

# Business-data mirror spreadsheet — separate from the registry above, web-only,
# fire-and-forget mirror of Postgres (not part of the name-unification effort).
SHEETS_DATA_ID=
